# 运行配置示例。**这里没有任何 secret**，也不要把真的值写进这个文件。
#
# 复制成 .env 并由部署环境注入；.env 本身不入 Git。

# ── 监听 ───────────────────────────────────────────────────────────────
# 默认只监听本机。要对外暴露时由代理/容器网络决定，别无脑改 0.0.0.0。
HOST=127.0.0.1
PORT=4173

# ── 请求预算（默认拒绝）──────────────────────────────────────────────────
# 累计上限。**不设就一个真实请求都不发**。
# 公开实例请用独立的一份额度，不要复用开发期的账本。
QLOO_REQUEST_BUDGET=
# 账本名：分开记账用。它是上限，不是开关。
QLOO_REQUEST_BUDGET_PHASE=

# ── 共享预算（无状态部署用；默认关闭）──────────────────────────────────
# 设成 1 时，额度计数放在**共享存储**上（Vercel Blob，私有），所有部署与环境
# 共用同一份计数 —— 服务器没有本地文件系统，文件账本在每次调用里都是一份从零
# 开始的副本，"全局最多 N 次"根本守不住。
# 这时必须给出下面两个变量，否则服务**拒绝启动**（不悄悄退回文件账本）。
QLOO_DURABLE_BUDGET=
# phase id：所有部署与环境共用同一个，所以计数是全局的；重新部署不会重置。
QLOO_DURABLE_PHASE_ID=
# 服务端存储适配器模块。**部署时不用设**：打包进来的适配器是静态引入的，
# 设这个变量只是给本地测试换假适配器用。
QLOO_BLOB_ADAPTER=
# 截止时间（ISO）：过了这一刻一律拒绝发请求。共享预算要求它存在。
QLOO_REQUEST_BUDGET_CUTOFF=

# ── 上游 ───────────────────────────────────────────────────────────────
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# http = 直连 HTTP 适配器（默认，用 Node 内建 fetch）
# cli  = 官方 CLI 接入面（开发/兼容路径，需要 dev 依赖 @qloo/qloo-harness）
QLOO_ACCESS_SURFACE=http

# ── 凭据（服务端内存读取，不回显、不进日志、不进前端、不进 argv）────────
# 文件内容形如 {"apiKey":"…"}；权限 0600，目录 0700。**不要提交这个文件。**
QLOO_CREDENTIALS_FILE=.taste-tuner/credentials.json

# ── 工具面 ─────────────────────────────────────────────────────────────
# 工具默认打本机实例；指向保存响应回放服务时可用缓存数据、不发业务请求。
TASTE_TUNER_BASE_URL=http://127.0.0.1:4173
# 输出里记录的来源标签（例如 replay）
TASTE_TUNER_SOURCE_LABEL=
# 私密回放目录：只有显式设置时，带真实响应的回归才会跑；否则清楚 skip。
TASTE_TUNER_REPLAY_DIR=
